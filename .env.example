# Local dev (same Wi-Fi): http://192.168.x.x:3000
# Production / APK testing: https://quickmartcorebackend.onrender.com
# Backend routes are under /api/v1 (handled automatically by the API client).
EXPO_PUBLIC_API_BASE_URL=https://quickmartcorebackend.onrender.com
EXPO_PUBLIC_API_VERSION=v1
EXPO_PUBLIC_USE_MOCK_API=false
EXPO_PUBLIC_API_DEBUG=true
# Physical phone workflow: npm run start:phone on laptop, open app on phone, press j for DevTools.
# Maps: MapLibre + OpenStreetMap by default (free, no API key).
# Optional custom MapLibre style URL (defaults to OSM raster tiles):
# EXPO_PUBLIC_MAP_STYLE_URL=
# Future Google Maps switch (requires native rebuild):
# EXPO_PUBLIC_USE_GOOGLE_MAPS=true
# EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
